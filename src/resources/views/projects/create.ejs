<div class="mt-4">
    <h3>Đăng Đồ Án Mới</h3>
    
    <form method="POST" action="/projects/store" class="mt-4">
        <div class="row">
            <div class="col-md-6 mb-3">
                <label for="title" class="form-label">Tên đồ án (*)</label>
                <input type="text" class="form-control" id="title" name="title" required placeholder="VD: Website Quản lý Bán hàng">
            </div>
            
            <div class="col-md-6 mb-3">
                <label for="techStack" class="form-label">Công nghệ sử dụng</label>
                <input type="text" class="form-control" id="techStack" name="techStack" placeholder="VD: NodeJS, MongoDB, Bootstrap">
            </div>

            <div class="col-md-6 mb-3">
                <label for="studentName" class="form-label">Tên sinh viên thực hiện (*)</label>
                <input type="text" class="form-control" id="studentName" name="studentName" required value="Võ Văn Tỷ">
            </div>

            <div class="col-md-6 mb-3">
                <label for="studentId" class="form-label">Mã số sinh viên (*)</label>
                <input type="text" class="form-control" id="studentId" name="studentId" required>
            </div>

            <div class="col-md-6 mb-3">
                <label for="githubLink" class="form-label">Link Github</label>
                <input type="url" class="form-control" id="githubLink" name="githubLink" placeholder="https://github.com/...">
            </div>

            <div class="col-md-6 mb-3">
                <label for="image" class="form-label">Link ảnh mô tả</label>
                <input type="url" class="form-control" id="image" name="image" placeholder="https://...">
            </div>
        </div>

        <div class="mb-3">
            <label for="description" class="form-label">Mô tả ngắn gọn đồ án</label>
            <textarea class="form-control" id="description" name="description" rows="4"></textarea>
        </div>

        <button type="submit" class="btn btn-primary">Thêm đồ án</button>
        <a href="/" class="btn btn-secondary">Hủy</a>
    </form>
</div>