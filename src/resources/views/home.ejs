<div class="mt-4">
    <h2 class="mb-4">Danh sách Đồ án</h2>

    <div class="row">
        <% if (projects && projects.length > 0) { %>
            
            <% projects.forEach(function(project) { %>
                <div class="col-sm-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <a href="/projects/<%= project.slug %>">
                            <img src="<%= project.image %>" class="card-img-top" alt="<%= project.title %>" style="height: 200px">
                        </a>
                        
                        <div class="card-body d-flex flex-column">
                            <a href="/projects/<%= project.slug %>" class="text-decoration-none text-dark">
                                <h5 class="card-title fw-bold"><%= project.title %></h5>
                            </a>
                            <p class="card-text text-muted mb-4"><%= project.description %></p>
                            
                            <a href="/projects/<%= project.slug %>" class="btn btn-primary mt-auto">Xem chi tiết</a>
                        </div>
                    </div>
                </div>
            <% }) %>

        <% } else { %>
            <div class="col-12 text-center mt-5">
                <h4 class="text-muted">Chưa có đồ án nào trong hệ thống.</h4>
                <a href="/projects/create" class="btn btn-success mt-3">Đăng đồ án đầu tiên ngay</a>
            </div>
        <% } %>
    </div>
</div>